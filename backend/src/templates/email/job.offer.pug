doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Congratulations on Your Job Offer - Akrio Job Tracker

  body(
    style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#1f2937;"
  )
    table(
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="width:100%; margin:0; padding:40px 16px; background-color:#f4f7fb;"
    )
      tr
        td(align="center")
          table(
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="width:100%; max-width:560px; background-color:#ffffff; border-radius:12px; overflow:hidden;"
          )
            tr
              td(
                align="center"
                style="padding:32px 24px; background-color:#176b87;"
              )
                h1(
                  style="margin:0; padding:0; color:#ffffff; font-size:26px; line-height:34px; font-weight:700;"
                )
                  | Akrio Job Tracker
                p(
                  style="margin:8px 0 0; padding:0; color:#d8eef3; font-size:14px; line-height:22px;"
                )
                  | Your next opportunity is within reach

            tr
              td(style="padding:40px 32px;")
                h2(
                  style="margin:0 0 16px; padding:0; color:#24292d; font-size:23px; line-height:30px; font-weight:700;"
                )
                  | Congratulations, #{name}!

                p(
                  style="margin:0 0 18px; padding:0; color:#374151; font-size:16px; line-height:26px;"
                )
                  | You have received a job offer from #{companyName}.

                p(
                  style="margin:0 0 24px; padding:0; color:#6b7280; font-size:15px; line-height:24px;"
                )
                  | Your application for #{jobTitle} has been marked as an offer in Akrio Job Tracker. Take a moment to celebrate this milestone.

                table(
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="width:100%; margin:0 0 24px;"
                )
                  tr
                    td(
                      align="center"
                      style="padding:20px 16px; background-color:#e8f5f7; border:1px solid #b9dfe7; border-radius:10px;"
                    )
                      p(
                        style="margin:0 0 8px; padding:0; color:#176b87; font-size:12px; line-height:18px; font-weight:700; text-transform:uppercase; letter-spacing:1px;"
                      )
                        | Offer received
                      p(
                        style="margin:0; padding:0; color:#24292d; font-size:20px; line-height:28px; font-weight:700;"
                      )
                        | #{jobTitle}

                p(
                  style="margin:0; padding:0; color:#6b7280; font-size:14px; line-height:22px;"
                )
                  | Please contact #{companyName} for the next steps and offer details.

            tr
              td(
                align="center"
                style="padding:24px 20px; background-color:#f8fafc; border-top:1px solid #e5e7eb;"
              )
                p(
                  style="margin:0; padding:0; color:#9ca3af; font-size:12px; line-height:18px;"
                )
                  | © #{year} Akrio Job Tracker. All rights reserved.
